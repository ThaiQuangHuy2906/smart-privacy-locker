  {"id":"state_fn","type":"function","z":"tab_dashboard","name":"Bearer owner then UI state","func":"const runtime=global.get('splRuntime');const lockerId=msg.req.params.lockerId;return runtime.authGate.authorize(msg.req.headers,lockerId).then(auth=>{if(!auth.ok){msg.statusCode=auth.status;msg.payload=auth;return msg;}msg.statusCode=200;msg.payload=runtime.uiState({authenticated:true,ownsLocker:true,lockerId});return msg;});","outputs":1,"x":510,"y":150,"wires":[["state_response"]]},
