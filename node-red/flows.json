  {"id":"timeout_tick","type":"inject","z":"tab_command","name":"Timeout scheduler 250 ms","props":[{"p":"payload"}],"repeat":"0.25","crontab":"","once":false,"onceDelay":"0.1","topic":"","payload":"","payloadType":"date","x":180,"y":180,"wires":[["timeout_fn"]]},
  {"id":"timeout_fn","type":"function","z":"tab_command","name":"Expire pending; one GET_STATE max","func":"const runtime=global.get('splRuntime');if(!runtime)return null;const results=runtime.dispatcher.expire();const outbox=global.get('splOutbox')||[];const mqtt=[];while(outbox.length){const item=outbox.shift();mqtt.push({topic:item.topic,payload:JSON.stringify(item.payload),retain:false,qos:0});}return [results.length?{payload:results}:null,mqtt.length?mqtt:null];","outputs":2,"x":500,"y":180,"wires":[["timeout_debug"],["mqtt_out_link"]]},
  {"id":"timeout_debug","type":"debug","z":"tab_command","name":"Controlled timeout results","active":true,"tosidebar":true,"console":false,"tostatus":false,"complete":"payload","targetType":"msg","x":820,"y":170,"wires":[]},

