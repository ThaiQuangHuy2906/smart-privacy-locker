  {"id":"mqtt_status_fn","type":"function","z":"tab_mqtt","name":"Broker status + reconnect bootstrap","func":"let runtime=global.get('splRuntime');let outbox=global.get('splOutbox');\nif(!Array.isArray(outbox)){outbox=[];global.set('splOutbox',outbox);}\nif(!runtime){const factory=global.get('splRuntimeFactory');if(!factory){node.error('splRuntimeFactory missing; apply settings.example.js');return null;}runtime=factory({publish:(topic,payload,options)=>outbox.push({topic,payload,options})});global.set('splRuntime',runtime);}\nconst text=msg.status&&msg.status.text;const connected=text==='connected'||text==='node-red:common.status.connected';\nconst lockerIds=String(env.get('LOCKER_ID')||'').split(',').map(value=>value.trim()).filter(value=>/^[A-Z0-9][A-Z0-9_-]{0,31}$/.test(value));\nruntime.setMqttConnected(connected,lockerIds);\nconst mqtt=[];while(outbox.length){const item=outbox.shift();mqtt.push({topic:item.topic,payload:JSON.stringify(item.payload),retain:false,qos:0});}\nreturn mqtt.length?[mqtt]:null;","outputs":1,"noerr":0,"initialize":"","finalize":"","libs":[],"x":520,"y":280,"wires":[["mqtt_out"]]},

  {"id":"cmd_http","type":"http in","z":"tab_command","name":"POST protected command","url":"/api/v1/commands","method":"post","upload":false,"swaggerDoc":"","x":170,"y":80,"wires":[["cmd_fn"]]},
  {"id":"cmd_fn","type":"function","z":"tab_command","name":"Bearer + owner + readiness + dispatch","func":"const runtime=global.get('splRuntime');\nconst request=msg.req;let responseClosed=false;\nconst response=msg.res&&(msg.res._res||msg.res);\nif(response&&typeof response.once==='function')response.once('close',()=>{if(!response.writableEnded)responseClosed=true;});\nconst isAborted=()=>Boolean(responseClosed||(request&&(request.aborted||(request.destroyed&&request.complete===false))));\nif(isAborted())return null;\nreturn runtime.protectedCommand({headers:request.headers,body:msg.payload,isAborted}).then(result=>{\n if(isAborted())return null;\n msg.statusCode=result.status||(result.ok?202:400);msg.payload=result;\n const outbox=global.get('splOutbox')||[];const mqtt=[];while(outbox.length){const item=outbox.shift();mqtt.push({topic:item.topic,payload:JSON.stringify(item.payload),retain:false,qos:0});}\n node.send([msg,mqtt.length?mqtt:null]);return null;\n});","outputs":2,"noerr":0,"initialize":"","finalize":"","libs":[],"x":500,"y":80,"wires":[["cmd_response"],["mqtt_out_link"]]},
