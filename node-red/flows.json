  {"id":"init_fn","type":"function","z":"tab_mqtt","name":"Create runtime (pending/window/cache empty)","func":"const factory=global.get('splRuntimeFactory');\nif(!factory){node.error('splRuntimeFactory missing; apply settings.example.js');return null;}\nconst outbox=[];\nconst runtime=factory({publish:(topic,payload,options)=>outbox.push({topic,payload,options})});\nglobal.set('splRuntime',runtime);global.set('splOutbox',outbox);\nnode.status({fill:'green',shape:'dot',text:'runtime ready'});return null;","outputs":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":500,"y":60,"wires":[]},
  {"id":"mqtt_in","type":"mqtt in","z":"tab_mqtt","name":"ACK/state/door/availability","topic":"locker/+/+","qos":"0","datatype":"auto-detect","broker":"broker","nl":false,"rap":true,"rh":0,"inputs":0,"x":190,"y":140,"wires":[["mqtt_ingress"]]},
  {"id":"mqtt_door_in","type":"mqtt in","z":"tab_mqtt","name":"Door telemetry","topic":"locker/+/telemetry/door","qos":"0","datatype":"auto-detect","broker":"broker","nl":false,"rap":true,"rh":0,"inputs":0,"x":170,"y":200,"wires":[["mqtt_ingress"]]},
  {"id":"mqtt_ingress","type":"function","z":"tab_mqtt","name":"Validate then update cache/ACK/security","func":"const runtime=global.get('splRuntime');if(!runtime){node.warn('runtime not ready');return null;}\nreturn runtime.ingest(msg.topic,msg.payload,Date.now()).then(result=>{\n const outbox=global.get('splOutbox')||[];const mqtt=[];while(outbox.length){const item=outbox.shift();mqtt.push({topic:item.topic,payload:JSON.stringify(item.payload),retain:false,qos:0});}\n if(!result.accepted){return [{payload:{code:result.code,topic:msg.topic}},null,null];}\n return [null,{payload:result},mqtt.length?mqtt:null];\n});","outputs":3,"noerr":0,"initialize":"","finalize":"","libs":[],"x":500,"y":170,"wires":[["safe_diag"],["validated_link"],["mqtt_out"]]},
