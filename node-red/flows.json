  {"id":"mqtt_ingress","type":"function","z":"tab_mqtt","name":"Validate then update cache/ACK/security","func":"let runtime=global.get('splRuntime');let outbox=global.get('splOutbox');\nif(!Array.isArray(outbox)){outbox=[];global.set('splOutbox',outbox);}\nif(!runtime){const factory=global.get('splRuntimeFactory');if(!factory){node.error('splRuntimeFactory missing; apply settings.example.js');return null;}runtime=factory({publish:(topic,payload,options)=>outbox.push({topic,payload,options})});global.set('splRuntime',runtime);}\nreturn runtime.ingest(msg.topic,msg.payload,Date.now()).then(result=>{\n const mqtt=[];while(outbox.length){const item=outbox.shift();mqtt.push({topic:item.topic,payload:JSON.stringify(item.payload),retain:false,qos:0});}\n if(!result.accepted){return [{payload:{code:result.code,topic:msg.topic}},null,null];}\n return [null,{payload:result},mqtt.length?mqtt:null];\n});","outputs":3,"noerr":0,"initialize":"","finalize":"","libs":[],"x":500,"y":170,"wires":[["safe_diag"],["validated_link"],["mqtt_out"]]},
