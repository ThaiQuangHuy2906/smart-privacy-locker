  {"id":"chat_fn","type":"function","z":"tab_chat","name":"Bearer + owner + classifier + grounding","func":"const runtime=global.get('splRuntime');return runtime.protectedChat({headers:msg.req.headers,body:msg.payload}).then(result=>{msg.statusCode=result.status||(result.ok?200:result.code==='LIVE_STATE_UNAVAILABLE'?409:503);msg.payload=result;return msg;});","outputs":1,"x":520,"y":80,"wires":[["chat_response"]]},
