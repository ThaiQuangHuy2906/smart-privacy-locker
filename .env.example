# Locker dùng cho demo User A / Locker A
LOCKER_ID=LOCKER-001

# MQTT broker
# These are the trusted Node-RED/simulator credentials. Broker ACL must allow
# Publish + Subscribe on locker/+/#. Firmware uses a different credential
# restricted to locker/LOCKER-001/#.
MQTT_HOST=<hostname-cua-mqtt-broker-khong-co-mqtt://>
MQTT_PORT=8883
MQTT_USERNAME=<mqtt-username>
MQTT_PASSWORD=<mqtt-password>
MQTT_TLS=true
MQTT_CA_CERT_PATH=

# Runtime — có thể giữ nguyên
COMMAND_TIMEOUT_MS=5000
COMMAND_MAX_AGE_SECONDS=120
AUTHORIZED_UNLOCK_WINDOW_SECONDS=30
DEVICE_STALE_AFTER_SECONDS=30

# URL thật của ứng dụng sau khi deploy FlowFuse. /locker là route chính;
# FlowFuse export vẫn phục vụ /phase2 như alias tương thích cho link cũ.
DASHBOARD_BASE_URL=https://<ten-instance-cua-ban>.flowfuse.cloud/locker

# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<sb_publishable_...>
SUPABASE_SERVICE_ROLE_KEY=

# Chỉ dùng cho live gate P2-M03. Cần custom SMTP (khuyến nghị SMTP
# sandbox) và một template email test có {nonce}, ví dụ:
# phase2+{nonce}@<domain-hop-thu-ban-kiem-soat>
# Không dùng example.com/.test; Supabase từ chối các test domain.
PHASE2_SIGNUP_TEST_EMAIL_TEMPLATE=

# Live E2E operator account. Keep real credentials only in the ignored .env;
# these values are read by the live gate scripts and are never bundled into
# the FlowFuse artifact. E2E_FORBIDDEN_LOCKER_ID is optional and should name a
# locker owned by another test account when cross-owner checks are required.
E2E_BASE_URL=https://<ten-instance-cua-ban>.flowfuse.cloud/locker
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
E2E_LOCKER_ID=LOCKER-001
E2E_FORBIDDEN_LOCKER_ID=

# Telegram — bắt buộc cho liên kết tài khoản tự động và cảnh báo YC6
TELEGRAM_BOT_TOKEN=
# Username của bot, không gồm ký tự @. Dashboard dùng giá trị này để mở
# https://t.me/<bot>?start=<one-time-token>; người dùng không nhập Chat ID.
TELEGRAM_BOT_USERNAME=
# Chuỗi ngẫu nhiên riêng cho webhook, dài tối thiểu 16 ký tự và chỉ gồm
# A-Z, a-z, 0-9, dấu gạch dưới hoặc gạch ngang.
TELEGRAM_WEBHOOK_SECRET=

# Gemini — có thể để trống cho tới khi chạy P2-M08
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Secret tự sinh, không gửi cho người khác
NODE_RED_CREDENTIAL_SECRET=<chuoi-ngau-nhien-dai>

REPORT_TIMEZONE=Asia/Ho_Chi_Minh

# YC7 — SMTP gửi báo cáo email hằng ngày. Dùng app password/SMTP credential
# riêng của deployment; không commit giá trị thật vào Git.
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=465
GMAIL_SMTP_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM=
